{
  "manifest_version": 3,
  "name": "סורק מסמכי בתי הדין הרבניים",
  "version": "0.1.0",
  "description": "מאתר את כל התיקים (פתוחים וסגורים), מוריד את המסמכים, ממיין ומשנה שמות לפי תוכן.",
  "content_scripts": [
    {
      "matches": [
        "https://sides.rbc.gov.il/Pages/FilesList.aspx*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-host.html",
        "pdf-host.js",
        "ocr/*",
        "pdfjs-wasm/*"
      ],
      "matches": [
        "https://sides.rbc.gov.il/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
